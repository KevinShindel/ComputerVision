# ── ML Backend server settings ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=9090
MODEL_DIR=./yolo-sam-backend

# ── Model selection ──────────────────────────────────────────────────────────
# YOLO26 variants: yolo26n.pt.default (fastest) | yolo26s.pt | yolo26m.pt | yolo26l.pt
YOLO_MODEL=models/yolo26n.pt
# SAM2 variants: sam2.1_t.pt (tiny) | sam2.1_b.pt (base) | sam2.1_l.pt (large)
SAM_MODEL=models/sam2.1_b.pt

# ── Detection thresholds ─────────────────────────────────────────────────────
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# ── Label Studio annotation tag names (must match your labeling config XML) ──
POLYGON_FROM_NAME=label
BBOX_FROM_NAME=bbox_labels
IMAGE_TO_NAME=image
IMAGE_VALUE=image

# ── Label Studio connection (used to download images) ────────────────────────
# Set these so the backend can fetch images from Label Studio
LABEL_STUDIO_URL=http://127.0.0.1:8080
# Get your token from: Label Studio → Account → Access Token
LABEL_STUDIO_ACCESS_TOKEN=
